# Copy this file to ".env" and fill in your Spotify app's Client ID.
# Get one (free) at https://developer.spotify.com/dashboard
#
# In the Spotify dashboard, add this exact Redirect URI to your app:
#   http://127.0.0.1:3000/callback
# (Spotify no longer accepts "localhost" for new apps — use the 127.0.0.1 loopback IP,
#  and open the app at http://127.0.0.1:3000 instead of http://localhost:3000)
#
# The Client ID is NOT a secret in the PKCE flow, so it's safe in the browser.
# Do NOT put the Client Secret here — we don't use it.

REACT_APP_SPOTIFY_CLIENT_ID=
REACT_APP_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
